<?xml version="1.0" encoding="utf-8"?>
<!--
  涵蓋率只統計本套件。相依套件與測試組件本身被排除 ——
  把 Ozakboy.Core.Abstractions 算進來會讓數字反映的是「這個套件用了它多少功能」而不是「這個套件被測到多少」,
  兩者完全是不同的事。
  Coverage measures this package only; the dependency and the test assembly are excluded. Counting
  Ozakboy.Core.Abstractions would report how much of it this package happens to use rather than how much of this
  package is tested, which are entirely different questions.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Exclude>
        <ModulePath>.*Ozakboy\.Core\.Abstractions\.dll$</ModulePath>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
