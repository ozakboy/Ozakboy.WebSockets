<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>

    <!--
      改用 MSTest 內建的 Microsoft.Testing.Platform 執行器,不走舊的 VSTest。
      理由是相依政策:VSTest 那條路徑會經由 Microsoft.TestPlatform.ObjectModel 遞移帶進
      Newtonsoft.Json —— 它掛在 Microsoft 的套件底下,但本身是第三方社群套件,
      而本專案的判定標準是遞移相依而非套件名稱。換成 MTP 之後整棵相依樹只剩 Microsoft.* 與 System.*。
      搭配 repo 根目錄的 global.json(test.runner),.NET 10 的 dotnet test 才會走 MTP。
      Uses MSTest's built-in Microsoft.Testing.Platform runner instead of the legacy VSTest path.
      This is a dependency-policy decision: VSTest transitively drags in Newtonsoft.Json through
      Microsoft.TestPlatform.ObjectModel. It sits under a Microsoft package but is itself a third-party
      community library, and this project judges by the transitive graph rather than by package name.
      The repo-level global.json (test.runner) is what makes dotnet test on .NET 10 pick MTP up.
    -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    刻意不參照 MSTest 整合套件,而是直接點名它底下需要的部分。
    MSTest 整合套件會帶進 Microsoft.NET.Test.Sdk → Microsoft.TestPlatform.TestHost → Newtonsoft.Json,
    而 Newtonsoft.Json 是第三方社群套件,違反本專案「只用 BCL 與 Microsoft 官方套件」的相依政策。
    Deliberately avoids the MSTest metapackage and names the pieces it needs instead, keeping Newtonsoft.Json
    (a third-party library pulled in transitively by the VSTest host) out of the graph entirely.
  -->
  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ozakboy.WebSockets\Ozakboy.WebSockets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Ozakboy.Core.Abstractions" />
    <Using Include="Ozakboy.WebSockets" />
  </ItemGroup>

</Project>
